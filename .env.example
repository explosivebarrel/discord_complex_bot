# --- Discord ---
# Bot token: Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Application (client) id, used for invite URL and OAuth2
DISCORD_CLIENT_ID=
# OAuth2 client secret: Developer Portal -> OAuth2 -> Client secret
DISCORD_CLIENT_SECRET=
# Must match a redirect URI registered in the Developer Portal (OAuth2 -> Redirects)
DISCORD_REDIRECT_URI=http://adajax.ddns.net/api/auth/callback

# Space-separated Discord user ids with super-admin (full control) in the web panel
SUPERADMIN_IDS=

# --- Web app ---
# Secret used to sign OAuth2 state and session cookies (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=change-me
# Public base URL of the web panel (used to build OAuth links)
BASE_URL=http://adajax.ddns.net

# --- Database ---
# SQLite file path (docker: /data/bot.db)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# --- Lavalink ---
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=change-me-too
LAVALINK_SECURE=false

# --- App runtime ---
LOG_LEVEL=INFO

# Google OAuth refresh token for the Lavalink youtube plugin (set after first OAuth login)
YOUTUBE_REFRESH_TOKEN=

# Yandex Music OAuth token (Plus recommended). Get: https://oauth.yandex.ru/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d
YANDEX_MUSIC_ENABLED=false
YANDEX_MUSIC_TOKEN=
