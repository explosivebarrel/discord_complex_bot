# --- Discord ---
# Bot token: Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Application (client) id, used for invite URL and OAuth2
DISCORD_CLIENT_ID=
# OAuth2 client secret: Developer Portal -> OAuth2 -> Client secret
DISCORD_CLIENT_SECRET=
# Must match a redirect URI registered in the Developer Portal (OAuth2 -> Redirects)
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Space-separated Discord user ids with super-admin (full control) in the web panel
SUPERADMIN_IDS=

# --- Web app ---
# Secret used to sign OAuth2 state and session cookies (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=change-me
# Public base URL of the web panel (used to build OAuth links)
BASE_URL=http://localhost:8000

# --- Database ---
# SQLite file path (docker: /data/bot.db)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# --- Lavalink ---
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=change-me-too
LAVALINK_SECURE=false

# --- App runtime ---
LOG_LEVEL=INFO
# Display name in the web panel and the browser tab (default: discord_complex_bot)
BOT_NAME=

# Google OAuth refresh token for the Lavalink youtube plugin (set after first OAuth login)
YOUTUBE_REFRESH_TOKEN=

# Yandex Music OAuth token (Plus recommended). Get: https://oauth.yandex.ru/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d
YANDEX_MUSIC_ENABLED=false
YANDEX_MUSIC_TOKEN=

# VK Music audio token with the audio scope (mobile-client implicit flow).
# See the Settings page in the panel for the exact URL. Optional.
VK_MUSIC_TOKEN=

# Panel uploads: max size of one uploaded audio file in megabytes.
MAX_UPLOAD_MB=50

# The gateway container's loopback port on the host: the system nginx
# proxies the panel domain to 127.0.0.1:<this port>. Pick a free one
# (`ss -tlnp` on the server); the server convention numbers its own
# gateways from 8101.
GATEWAY_EXPOSED_PORT=8101

# --- Voice call recording (local faster-whisper) ---
# Whisper model size: tiny / base / small / medium (int8 on CPU).
TRANSCRIBE_MODEL=small
# Expected spoken language; leave empty for auto-detect.
TRANSCRIBE_LANGUAGE=ru
